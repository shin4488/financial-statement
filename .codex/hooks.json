{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/codex-hook.py\" format-lint.sh",
            "timeout": 60,
            "statusMessage": "フォーマッタ・リンタを実行中"
          }
        ]
      }
    ]
  }
}

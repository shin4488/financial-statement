{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.codex/hooks/format-lint.sh\"",
            "timeout": 60,
            "statusMessage": "フォーマッタ・リンタを実行中"
          }
        ]
      }
    ]
  }
}
